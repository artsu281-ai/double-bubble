    },
    "Add an app to run a second, fully separate account alongside it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте приложение, чтобы запустить рядом второй полностью отдельный аккаунт."
