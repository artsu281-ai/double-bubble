    "Clears the app list along with account names and colors. Anything still running is stopped first. The apps themselves, and their data on disk, are not touched.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищает список приложений вместе с именами и цветами аккаунтов. Всё запущенное сначала останавливается. Сами приложения и их данные на диске не трогаются."
          }
        }
      }
    },
    "Color": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвет"
