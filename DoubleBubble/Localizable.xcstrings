    "A copy of “%@”": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия «%@»"
          }
        }
      }
    },
    "A lit edge, a soft sheen and a shadow under the mark. It fades out on its own at small sizes, so the Dock stays legible.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая обводка сверху, мягкий блеск и тень под значком. При уменьшении масштаба эффект сам сходит на нет, чтобы значок оставался чётким в Dock."
          }
        }
      }
    },
    "A new %@ account with a copy of its data.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый аккаунт %@ с копией данных оригинала."
          }
        }
      }
    },
