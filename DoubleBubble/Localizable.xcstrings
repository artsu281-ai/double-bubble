      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь лежат изолированные данные всех аккаунтов и переподписанные копии приложений."
          }
        }
      }
    },
    "How much space each account's isolated copy or data folder is using, shown next to its status.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько места занимает изолированная копия или папка данных каждого аккаунта — показывается рядом со статусом."
          }
