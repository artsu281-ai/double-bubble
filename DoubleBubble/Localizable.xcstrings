    },
    "%lld accounts are still open. They’ll keep running in the background — Double Bubble will reconnect to them next time it launches.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё открыто аккаунтов: %lld. Они продолжат работать в фоне — Double Bubble снова подключится к ним при следующем запуске."
          }
        }
      }
    },
