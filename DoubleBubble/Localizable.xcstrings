{
  "sourceLanguage": "en",
  "strings": {
    " This app will have no accounts left until you add one again.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " После этого у приложения не останется аккаунтов, пока вы не добавите новый."
          }
        }
      }
    },
    "%@": {},
    "%@ across %lld accounts": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — аккаунтов: %lld"
          }
        }
      }
    },
    "%@ already exist. Accounts are kept apart by more than their name, so this works — it is just harder to read.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — такие имена уже есть. Аккаунты различаются не только именем, так что всё сработает, просто читать будет сложнее."
          }
        }
      }
    },
    "%@ already has an account on its own profile": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У «%@» уже есть аккаунт на собственном профиле"
          }
        }
      }
    },
    "%@ already has an account on its own profile.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
