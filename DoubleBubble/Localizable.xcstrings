    "%@ is installed and can run two accounts": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» установлен и умеет работать с двумя аккаунтами"
          }
        }
      }
    },
