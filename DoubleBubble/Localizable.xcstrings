    "%lld accounts are open and will be stopped.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыто аккаунтов: %lld — все будут остановлены."
          }
        }
