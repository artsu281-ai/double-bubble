    "Keeps Double Bubble available in the menu bar as soon as you sign in, so accounts you left running are never orphaned by a restart.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Double Bubble появится в строке меню сразу после входа, и оставленные запущенными аккаунты не потеряются при перезагрузке."
          }
        }
      }
    },
